# =============================================================================
# KULTRA SENTINEL - ENVIRONMENT & API CONFIGURATION
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
# Obtain your free serverless Postgres connection string from: https://neon.tech
# Example pooled connection string:
DATABASE_URL="postgresql://kultra_owner:your_neon_password@ep-cold-bush-a5xyz.us-east-2.aws.neon.tech/kultra_db?sslmode=require"

# -----------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SESSION SECRET
# -----------------------------------------------------------------------------
# Generate a random 32-character string (e.g. openssl rand -base64 32):
AUTH_SECRET="kultra-sentinel-mission-control-secure-jwt-key-2026!"

# Default Bootstrap Administrator Credentials (used for initial sign-in):
ADMIN_DEFAULT_EMAIL="admin@kultra.ai"
ADMIN_DEFAULT_PASSWORD="KultraSentinel2026!"

# -----------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (For "Continue with Google" Admin Sign-In)
# -----------------------------------------------------------------------------
# Setup steps:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production:  https://your-vercel-domain.vercel.app/api/auth/google/callback
# 4. Paste your Client ID and Client Secret below:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 4. GOOGLE CLOUD PUB/SUB & MERCHANT API v1 (For Production Push Ingestion)
# -----------------------------------------------------------------------------
# Google Cloud Project ID hosting the Pub/Sub topic:
GOOGLE_CLOUD_PROJECT_ID=""
# Pub/Sub Push Subscription verification token:
PUBSUB_VERIFICATION_TOKEN=""

# -----------------------------------------------------------------------------
# 5. INCIDENT DISPATCH WEBHOOKS (Optional)
# -----------------------------------------------------------------------------
# Slack Bot or Incoming Webhook for merchant channel dispatch:
SLACK_WEBHOOK_URL=""
